# Validation appliance only; installed gateway runs as native systemd services.
FROM debian:bookworm
ENV container=docker DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv python3 python3-yaml nftables iproute2 procps ca-certificates curl util-linux openvpn openssl \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
