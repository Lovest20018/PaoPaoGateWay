[Unit]
Description=PaoPaoGateway HNM observer API
After=network.target

[Service]
Type=simple
User=paopaogw-api
Group=paopaogw-api
ExecStart=/usr/bin/python3 /usr/local/lib/paopaogw/gateway_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
